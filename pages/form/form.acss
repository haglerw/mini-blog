.form-container {
  padding: 24rpx;
}

.form-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-left: 50rpx;
}

.form-actions {
  margin-top: 40rpx;
}

.error-text {
  color: #ff4d4f;
  font-size: 24rpx;
  margin-top: 3rpx;
  margin-bottom: 10rpx;
}